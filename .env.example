# ============ Telegram ============
BOT_TOKEN=
ADMIN_ID=
BOT_NAME=Нейро

# ============ Учитель (источник знаний) ============
# web = реальный чат gemini.google.com через браузер (как ты и просил)
# api = официальный бесплатный Gemini API (запасной вариант, те же модели)
TEACHER=web

# --- режим web ---
GEMINI_WEB_URL=https://gemini.google.com/app
# false = видно окно браузера (нужно для первого входа), true = фоном
GEMINI_WEB_HEADLESS=false
GEMINI_WEB_TIMEOUT=180
# каждый вопрос — в новом чате Gemini (контекст держит мой ИИ, а не Gemini)
GEMINI_WEB_NEW_CHAT=true

# --- режим api (ключ бесплатно: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============ Медиа ============
# максимальный размер файла в МБ (Telegram всё равно не отдаёт больше 20)
MAX_MEDIA_MB=20
# сколько файлов из одного альбома брать за раз
MAX_ALBUM=6

# ============ Мозг ============
# порог схожести вопроса, чтобы отвечать из своей памяти (0..1)
SIM_THRESHOLD=0.88
# сколько реплик диалога помнить
CONTEXT_TURNS=12
