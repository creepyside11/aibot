# ============ Telegram ============
# Bothost already exposes BOT_TOKEN as an environment variable. Do not commit real secrets.
BOT_TOKEN=
ADMIN_ID=
BOT_NAME=Нейро

# ============ Shared database ============
# Use the same PostgreSQL DATABASE_URL as Emerald. aibot uses its own PostgreSQL schema
# (aibot by default), so its users/messages/settings do not collide with Emerald tables.
DATABASE_URL=postgresql://user:password@host:5432/database
AIBOT_DB_SCHEMA=aibot

# ============ Bothost remote Chrome ============
# Password for the noVNC page used to sign in to Google from a phone/browser.
# If omitted, the container generates one, stores it in /app/data and prints it in logs.
BROWSER_PASSWORD=
# Optional override. Normally DOMAIN from Bothost is used automatically.
REMOTE_BROWSER_URL=

# ============ Учитель (источник знаний) ============
# web = реальный чат gemini.google.com через Chrome
# api = официальный Gemini API
TEACHER=web

# --- режим web ---
GEMINI_WEB_URL=https://gemini.google.com/app
# On Bothost keep false: Chrome runs in Xvfb and is visible through noVNC.
GEMINI_WEB_HEADLESS=false
GEMINI_WEB_TIMEOUT=180
GEMINI_WEB_NEW_CHAT=true

# --- режим api ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============ Media ============
MAX_MEDIA_MB=20
MAX_ALBUM=6

# ============ Brain ============
SIM_THRESHOLD=0.88
CONTEXT_TURNS=12
